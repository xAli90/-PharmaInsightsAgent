# Copy to .env and adjust. Placeholders only, never commit real keys.

# OpenAI-compatible endpoint (default: LM Studio on this machine)
OPENAI_BASE_URL=http://localhost:1234/v1

# LM Studio: any value, or the API token if authentication is on
OPENAI_API_KEY=lm-studio

# Model name as shown by the endpoint (tested: Qwen3.8-27B-MLX-4bit in LM Studio, Apple Silicon only)
OPENAI_MODEL=qwen/qwen3.8-27b

# Model calls per question, at least 2
AGENT_MAX_ROUNDS=3

# Sent to the model as reasoning_effort
LLM_REASONING_EFFORT=low
